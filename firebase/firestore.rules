rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId)   { return request.auth.uid == userId; }
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.admin == true;
    }

    function validDepositCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.amount is number
          && d.amount > 0;
    }

    // Withdrawal validation: client writes status=pending, amount>0, bank, accountNumber.
    // Balance is NOT reserved here — admin approves via approveWithdrawal CF which
    // atomically deducts balance. No rejection path exists; admin deletes if needed.
    function validWithdrawalCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.amount is number
          && d.amount > 0
          && d.bank is string
          && d.accountNumber is string;
    }

    match /users/{userId} {
      allow read:  if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write: if isAdmin();

      match /deposits/{depositId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && validDepositCreate();
        allow update: if isAdmin();
        allow delete: if isAdmin()
                   || (isAuthenticated() && isOwner(userId)
                       && resource.data.status == 'rejected');
      }

      match /withdrawals/{withdrawId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && validWithdrawalCreate();
        // Only admin can update (approve) or delete withdrawals.
        // There is no client-side rejection — admin either approves or deletes.
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /cartelas/{cartelaId} {
        allow read:  if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if false;
      }

      match /cards/{cardId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow update: if isAuthenticated()
                      && isOwner(userId)
                      && (
                           request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['blocked'])
                           ||
                           (
                             request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status', 'sessionId', 'blocked'])
                             && request.resource.data.status == 'pending'
                             && request.resource.data.sessionId == ''
                             && request.resource.data.blocked == false
                           )
                         );
        allow create: if false;
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    match /{path=**}/deposits/{depositId} {
      allow read: if isAdmin();
    }
    match /{path=**}/withdrawals/{withdrawId} {
      allow read: if isAdmin();
    }

    match /bank_notifications/{notificationId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /metadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /payment_settings/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /games/live {
      allow read:  if isAuthenticated();
      allow update: if isAdmin()
                 || (isAuthenticated()
                     && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['blockedCardNos']));
      allow create, delete: if isAdmin();
    }

    match /games/live/draws/{drawId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    match /games/live/sessions/{sessionId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    match /game_history/{historyId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }

    match /top_players/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false;
    }
  }
}
