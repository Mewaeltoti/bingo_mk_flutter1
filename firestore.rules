rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Helper functions -------------------------------------------------
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.admin == true || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // ---- Users & Sub‑collections -------------------------------------------
    match /users/{userId} {
      // Users can read their own profile or any profile if they are admin.
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      // Only admins can modify user documents (e.g., role changes).
      allow write: if isAdmin();

      // ----- Deposits (admin‑only writes)
      match /deposits/{depositId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAdmin();
      }

      // ----- Withdrawals (user can create, admin can modify)
      match /withdrawals/{withdrawId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId);
        allow update, delete: if isAdmin();
      }

      // ----- Cartelas & Cards – read‑only for client, write only via CF
      match /cartelas/{cartelaId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if false;   // Cloud Functions only
      }
      match /cards/{cardId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if false;   // Cloud Functions only
      }
    }

    // ---- Live Game Document -------------------------------------------------
    match /games/live {
      // UI can freely read the live game state.
      allow read: if true;
      // Writes (e.g., start/stop game, admin actions) must be admin‑only.
      allow write: if isAdmin();
    }

    // ---- Game History & Leaderboard ----------------------------------------
    match /game_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if false;   // Cloud Functions only
    }
  }
}
