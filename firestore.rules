rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId)   { return request.auth.uid == userId; }
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.admin == true;
    }

    // ── Deposit field validation ─────────────────────────────────────────────
    // Prevents a client from creating a deposit with a fake status or amount.
    function validDepositCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.amount is number
          && d.amount > 0;
    }

    // ── Withdrawal field validation ──────────────────────────────────────────
    function validWithdrawalCreate() {
      let d = request.resource.data;
      return d.status == 'pending'
          && d.amount is number
          && d.amount > 0;
    }

    // ── Users & Sub-collections ─────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow write:  if isAdmin();

      // ── Deposits ──────────────────────────────────────────────────────────
      match /deposits/{depositId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
        // FIX: validate fields on create — prevents forged status/amount
        allow create: if isAuthenticated() && isOwner(userId) && validDepositCreate();
        allow update: if isAdmin();
        allow delete: if isAdmin()
                   || (isAuthenticated() && isOwner(userId)
                       && resource.data.status == 'rejected');
      }

      // ── Withdrawals ────────────────────────────────────────────────────────
      match /withdrawals/{withdrawId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());
        // FIX: validate fields on create — prevents forged status/amount
        allow create: if isAuthenticated() && isOwner(userId) && validWithdrawalCreate();
        allow update: if isAdmin();
        allow delete: if isAdmin()
                   || (isAuthenticated() && isOwner(userId)
                       && resource.data.status == 'rejected');
      }

      // ── Cartelas — read-only for client, writes via Cloud Functions ────────
      match /cartelas/{cartelaId} {
        allow read:  if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if false; // Cloud Functions only
      }

      // ── Cards ────────────────────────────────────────────────────────────────
      // Clients may NOT create or delete cards (Cloud Functions only).
      // Two narrow update paths are permitted:
      //   1. blockCard()         — sets {blocked: true} after a failed claim
      //   2. resetCardsForSession() — resets {status, sessionId, blocked}
      //      back to 'pending' when a new session starts (belt-and-suspenders
      //      fallback; Cloud Function resetSessionCards.js is the primary path)
      match /cards/{cardId} {
        allow read:   if isAuthenticated() && (isOwner(userId) || isAdmin());

        allow update: if isAuthenticated()
                      && isOwner(userId)
                      && (
                           // Path 1: block a single card after a failed claim
                           request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['blocked'])
                           ||
                           // Path 2: reset card to pending on session end
                           (
                             request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['status', 'sessionId', 'blocked'])
                             && request.resource.data.status == 'pending'
                             && request.resource.data.sessionId == ''
                             && request.resource.data.blocked == false
                           )
                         );

        allow create: if false; // registerCard Cloud Function only

        // deleteCardsForSession() is called client-side on session end to
        // purge stale cards.  Only the card owner may delete their own cards,
        // and only when the card belongs to them (ownership is implicit through
        // the /users/{userId}/cards/{cardId} path match above).
        allow delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // ── Collection-group queries (admin dashboard) ──────────────────────────
    match /{path=**}/deposits/{depositId} {
      allow read: if isAdmin();
    }
    match /{path=**}/withdrawals/{withdrawId} {
      allow read: if isAdmin();
    }

    // ── Bank SMS notifications ───────────────────────────────────────────────
    match /bank_notifications/{notificationId} {
      allow read:  if isAdmin();
      allow write: if isAdmin(); // Includes manual matching by admins
    }

    // ── Metadata (limits, config) ────────────────────────────────────────────
    match /metadata/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Payment settings (bank accounts shown to players) ───────────────────
    match /payment_settings/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Live game ────────────────────────────────────────────────────────────
    // FIX: was `allow read: if true` — unauthenticated users could read game
    //      state. Tightened to require authentication.
    match /games/live {
      allow read:  if isAuthenticated();

      // Full write (create/overwrite) is admin-only.
      // Narrow update: authenticated players may append to blockedCardNos
      // (broadcastBlockedCard) — no other field may be changed.
      allow update: if isAdmin()
                 || (isAuthenticated()
                     && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['blockedCardNos']));

      allow create, delete: if isAdmin();
    }

    // ── Draws sub-collection ─────────────────────────────────────────────────
    // FIX: was `allow read: if true` — same unauthenticated issue.
    match /games/live/draws/{drawId} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Sessions sub-collection ──────────────────────────────────────────────
    // FIX (new): streamGameDraws() reads games/live/sessions/{sessionId}.
    //            This path was completely missing → permission-denied on stream.
    match /games/live/sessions/{sessionId} {
      allow read:  if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── Game history ─────────────────────────────────────────────────────────
    match /game_history/{historyId} {
      allow read:  if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── Top players / leaderboard ────────────────────────────────────────────
    // FIX (new): this collection existed in the Flutter app rules but was
    //            missing here entirely → any leaderboard read would be denied.
    match /top_players/{docId} {
      allow read:  if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }
  }
}
